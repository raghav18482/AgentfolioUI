{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agentfolio.in" }],
      "destination": "https://agentfolio.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://myfinancesmcp.onrender.com/api/:path*" },
    { "source": "/static/:path*", "destination": "https://myfinancesmcp.onrender.com/static/:path*" },
    { "source": "/mcp/:path*", "destination": "https://myfinancesmcp.onrender.com/mcp/:path*" },
    { "source": "/oauth/:path*", "destination": "https://myfinancesmcp.onrender.com/oauth/:path*" },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://myfinancesmcp.onrender.com/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://myfinancesmcp.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://myfinancesmcp.onrender.com/.well-known/oauth-protected-resource/:path*"
    },
    { "source": "/login", "destination": "/spa" },
    { "source": "/login/:path*", "destination": "/spa" },
    { "source": "/enroll", "destination": "/spa" },
    { "source": "/enroll/:path*", "destination": "/spa" },
    { "source": "/dashboard", "destination": "/spa" },
    { "source": "/dashboard/:path*", "destination": "/spa" },
    { "source": "/positions", "destination": "/spa" },
    { "source": "/positions/:path*", "destination": "/spa" },
    { "source": "/orders", "destination": "/spa" },
    { "source": "/orders/:path*", "destination": "/spa" },
    { "source": "/analytics", "destination": "/spa" },
    { "source": "/analytics/:path*", "destination": "/spa" },
    { "source": "/agent", "destination": "/spa" },
    { "source": "/agent/:path*", "destination": "/spa" },
    { "source": "/news", "destination": "/spa" },
    { "source": "/news/:path*", "destination": "/spa" },
    { "source": "/research", "destination": "/spa" },
    { "source": "/research/:path*", "destination": "/spa" },
    { "source": "/sectors", "destination": "/spa" },
    { "source": "/sectors/:path*", "destination": "/spa" },
    { "source": "/trading", "destination": "/spa" },
    { "source": "/trading/:path*", "destination": "/spa" }
  ]
}
